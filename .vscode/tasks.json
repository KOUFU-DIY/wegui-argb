{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "lite: stop running",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Get-Process -ErrorAction SilentlyContinue | Where-Object { $_.ProcessName -like 'wegui_lite*' } | Stop-Process -Force\"",
            "linux": {
                "command": "pkill -f wegui_lite || true"
            },
            "osx": {
                "command": "pkill -f wegui_lite || true"
            },
            "options": {
                "cwd": "${workspaceFolder}",
                "statusbar": {
                    "hide": true
                }
            },
            "presentation": {
                "reveal": "never",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "lite: build",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/SimLite/build_lite.ps1\"",
            "linux": {
                "command": "sh \"${workspaceFolder}/SimLite/build_lite.sh\""
            },
            "osx": {
                "command": "sh \"${workspaceFolder}/SimLite/build_lite.sh\""
            },
            "options": {
                "cwd": "${workspaceFolder}",
                "statusbar": {
                    "label": "$(tools) SimLite 编译",
                    "tooltip": "build_lite.ps1（tcc 优先，约 2 秒）"
                }
            },
            "dependsOrder": "sequence",
            "dependsOn": [
                "lite: stop running"
            ],
            "presentation": {
                "reveal": "silent",
                "focus": false,
                "showReuseMessage": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "lite: run",
            "type": "shell",
            "command": "powershell -NoProfile -Command \"Start-Process -FilePath '${workspaceFolder}/SimLite/build/wegui_lite.exe' -WorkingDirectory '${workspaceFolder}/SimLite/build'\"",
            "linux": {
                "command": "cd \"${workspaceFolder}/SimLite/build\" && ./wegui_lite &"
            },
            "osx": {
                "command": "cd \"${workspaceFolder}/SimLite/build\" && ./wegui_lite &"
            },
            "options": {
                "cwd": "${workspaceFolder}",
                "statusbar": {
                    "hide": true
                }
            },
            "presentation": {
                "reveal": "never",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "lite: build and run",
            "dependsOrder": "sequence",
            "dependsOn": [
                "lite: build",
                "lite: run"
            ],
            "options": {
                "statusbar": {
                    "label": "$(rocket) 编译+运行",
                    "tooltip": "编译 SimLite 后启动 wegui_lite.exe"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "lite: build dev (gcc, debug)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/SimLite/build_lite.ps1\" -Dev -Compiler gcc",
            "options": {
                "cwd": "${workspaceFolder}",
                "statusbar": {
                    "hide": true
                }
            },
            "dependsOrder": "sequence",
            "dependsOn": [
                "lite: stop running"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "lite: autotest",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/SimLite/autotest.ps1\"",
            "options": {
                "cwd": "${workspaceFolder}",
                "statusbar": {
                    "hide": true
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "stm32: build (AC5)",
            "type": "shell",
            "command": "& { $log = Join-Path '${workspaceFolder}' 'STM32F103/MDK-ARM/Objects/Project.build_log.htm'; $axf = Join-Path '${workspaceFolder}' 'STM32F103/MDK-ARM/Objects/Project.axf'; $null = Start-Process -FilePath '${config:wegui.keilUv4Path}' -ArgumentList '-j0','-b','${config:wegui.stm32ProjectFile}','-t','${config:wegui.stm32TargetName}' -PassThru -Wait; if (!(Test-Path $log) -or !(Test-Path $axf)) { Write-Error 'Keil did not generate Project.axf or build log.'; exit 1 }; $txt = Get-Content -Raw $log; if ($txt -match ' - 0 Error\\(s\\),') { exit 0 } else { Write-Error 'Keil build log contains errors.'; exit 1 } }",
            "options": {
                "cwd": "${workspaceFolder}/STM32F103/MDK-ARM",
                "statusbar": {
                    "hide": true
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "build"
        },
        {
            "label": "stm32: rebuild (AC5)",
            "type": "shell",
            "command": "& { $log = Join-Path '${workspaceFolder}' 'STM32F103/MDK-ARM/Objects/Project.build_log.htm'; $axf = Join-Path '${workspaceFolder}' 'STM32F103/MDK-ARM/Objects/Project.axf'; $null = Start-Process -FilePath '${config:wegui.keilUv4Path}' -ArgumentList '-j0','-r','${config:wegui.stm32ProjectFile}','-t','${config:wegui.stm32TargetName}' -PassThru -Wait; if (!(Test-Path $log) -or !(Test-Path $axf)) { Write-Error 'Keil did not generate Project.axf or build log.'; exit 1 }; $txt = Get-Content -Raw $log; if ($txt -match ' - 0 Error\\(s\\),') { exit 0 } else { Write-Error 'Keil build log contains errors.'; exit 1 } }",
            "options": {
                "cwd": "${workspaceFolder}/STM32F103/MDK-ARM",
                "statusbar": {
                    "hide": true
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "stm32: open MDK project",
            "type": "shell",
            "command": "& { Start-Process -FilePath '${config:wegui.keilUv4Path}' -ArgumentList '${config:wegui.stm32ProjectFile}' }",
            "options": {
                "cwd": "${workspaceFolder}/STM32F103/MDK-ARM",
                "statusbar": {
                    "hide": true
                }
            },
            "presentation": {
                "reveal": "never",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
